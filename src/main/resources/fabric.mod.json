{
	"schemaVersion": 1,
	"id": "gamma",
	"version": "${version}",
	"name": "Gamma",
	"description": "A client-side Fabric mod for rendering, world visualization, and base/stash finding.",
	"authors": [
		"skylxne-py"
	],
	"contact": {
		"homepage": "https://github.com/skylxne-py/GammaClient",
		"sources": "https://github.com/skylxne-py/GammaClient",
		"issues": "https://github.com/skylxne-py/GammaClient/issues"
	},
	"icon": "assets/gamma/icon.png",
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.gamma.GammaClient"
		]
	},
	"mixins": [
		"gamma.mixins.json"
	],
	"accessWidener": "gamma.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
